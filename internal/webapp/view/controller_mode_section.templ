package view

import (
	"context"
	"fmt"
	"github.com/deseteral/resistere/internal/controller"
	"github.com/invopop/ctxi18n/i18n"
)

templ ControllerModeSection(c *controller.Controller) {
	{{ mode := c.Mode() }}
	<fieldset
		id="controller-mode-section"
		hx-get="/view/controller-mode"
		hx-trigger="load delay:5s"
		hx-swap="outerHTML"
	>
		<legend>{ i18n.T(ctx, "mode.tab_title") }</legend>
		<style>
		me {
			min-width: 0;
		}
		</style>
		<div>
			{ i18n.T(ctx, "mode.current_mode") }: <strong>{ getModeName(ctx, mode) }</strong>
		</div>
		<div
			hx-target="#controller-mode-section"
			hx-swap="outerHTML"
		>
			<style>
			me {
				display: flex;
				flex-direction: row;
				overflow-x: auto;
				padding-bottom: 2px;

				button {
					min-width: 130px;
					flex-shrink: 0;
					white-space: nowrap;
				}
			}
			</style>
			<button
				hx-post={ getUrlForModeButton(controller.ModePVAutomatic) }
				disabled?={ isModeButtonDisabled(controller.ModePVAutomatic, mode) }
			>
				<i class="ph-bold ph-sun"></i>
				{ getModeName(ctx, controller.ModePVAutomatic) }
			</button>
			<button
				hx-post={ getUrlForModeButton(controller.ModeManual) }
				disabled?={ isModeButtonDisabled(controller.ModeManual, mode) }
			>
				<i class="ph-bold ph-hand-tap"></i>
				{ getModeName(ctx, controller.ModeManual) }
			</button>
			<button
				hx-post={ getUrlForModeButton(controller.ModeManualUntilDisconnect) }
				disabled?={ isModeButtonDisabled(controller.ModeManualUntilDisconnect, mode) }
			>
				<i class="ph-bold ph-plug"></i>
				{ getModeName(ctx, controller.ModeManualUntilDisconnect) }
			</button>
		</div>
		<div>
			<style>
				me {
					font-size: 13px;
					font-style: italic;

					display: flex;
					flex-direction: row;
					align-items: center;

					margin-top: 16px;

					i {
						margin-right: 4px;
					}
				}
				</style>
			<i class="ph-bold ph-info"></i>
			{ getHelpMessageForMode(ctx, mode) }
		</div>
	</fieldset>
}

func getUrlForModeButton(buttonMode controller.Mode) string {
	return fmt.Sprintf("/controller/mode?value=%d", int(buttonMode))
}

func isModeButtonDisabled(buttonMode controller.Mode, currentMode controller.Mode) bool {
	return buttonMode == currentMode
}

func getModeName(ctx context.Context, mode controller.Mode) string {
	switch mode {
	case controller.ModePVAutomatic:
		return i18n.T(ctx, "mode.automatic")
	case controller.ModeManualUntilDisconnect:
		return i18n.T(ctx, "mode.manual_until_disconnect")
	default:
		return i18n.T(ctx, "mode.manual")
	}
}

func getHelpMessageForMode(ctx context.Context, mode controller.Mode) string {
	switch mode {
	case controller.ModePVAutomatic:
		return i18n.T(ctx, "mode.help_message_automatic")
	case controller.ModeManualUntilDisconnect:
		return i18n.T(ctx, "mode.help_message_manual_until_disconnect")
	default:
		return i18n.T(ctx, "mode.help_message_manual")
	}
}
